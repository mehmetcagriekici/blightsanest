# Copy this file to k8s/secret.env and fill in real values.
# k8s/secret.env is gitignored - never commit it.
#
# host names below (postgres/rabbitmq/semantic-api) match the Service names
# defined in this directory - keep them in sync if you rename a Service.

POSTGRES_USER=blightsanest
POSTGRES_PASSWORD=changeme
POSTGRES_DB=blightsanest_db

RABBITMQ_DEFAULT_USER=blightsanest
RABBITMQ_DEFAULT_PASS=changeme

COIN_GECKO_KEY=your-coingecko-api-key

DATABASE_URL=postgres://blightsanest:changeme@postgres:5432/blightsanest_db?sslmode=disable
RABBITMQ_URL=amqp://blightsanest:changeme@rabbitmq:5672
